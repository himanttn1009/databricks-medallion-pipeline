{
  "datasets": [
    {
      "name": "907219ac",
      "displayName": "KPI-01 Total Revenue",
      "queryLines": [
        "SELECT ROUND(SUM(total_revenue), 2) AS total_revenue\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "283471d9",
      "displayName": "KPI-02 Total Orders",
      "queryLines": [
        "SELECT\n",
        "    SUM(total_orders) AS total_orders\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "78fd32a1",
      "displayName": "KPI-03 Customer Count",
      "queryLines": [
        "SELECT\n",
        "    COUNT(customer_id) AS customer_count\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "df8a951c",
      "displayName": "KPI-04 Active Products",
      "queryLines": [
        "SELECT\n",
        "    category,\n",
        "    COUNT(product_id) AS product_count\n",
        "FROM gold.sales_by_product\n",
        "GROUP BY category\n",
        "ORDER BY category;"
      ]
    },
    {
      "name": "9cc546b4",
      "displayName": "VIZ-01 Top 10 Products",
      "queryLines": [
        "SELECT\n",
        "    product_name,\n",
        "    category,\n",
        "    total_revenue,\n",
        "    total_orders\n",
        "FROM gold.sales_by_product\n",
        "ORDER BY total_revenue DESC, product_name ASC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "3522dc68",
      "displayName": "VIZ-02 Customer Revenue Distribution",
      "queryLines": [
        "SELECT\n",
        "    customer_id,\n",
        "    customer_segment,\n",
        "    total_revenue\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "3db7b8ab",
      "displayName": "VIZ-03 Customer Segmentation",
      "queryLines": [
        "SELECT\n",
        "    segment_type,\n",
        "    customer_count,\n",
        "    total_revenue,\n",
        "    avg_revenue\n",
        "FROM gold.customer_segmentation\n",
        "ORDER BY\n",
        "    CASE segment_type\n",
        "        WHEN 'High-Value' THEN 1\n",
        "        WHEN 'Repeat' THEN 2\n",
        "        WHEN 'One-Time' THEN 3\n",
        "        WHEN 'Inactive' THEN 4\n",
        "        ELSE 5\n",
        "    END;"
      ]
    },
    {
      "name": "ccfa3884",
      "displayName": "VIZ-04 Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "    period_start,\n",
        "    period_type,\n",
        "    total_revenue,\n",
        "    total_orders\n",
        "FROM gold.daily_weekly_trends\n",
        "ORDER BY period_start ASC;"
      ]
    },
    {
      "name": "ba90db98",
      "displayName": "TBL-01 Customer Revenue Detail",
      "queryLines": [
        "SELECT\n",
        "    customer_id,\n",
        "    customer_name,\n",
        "    customer_segment,\n",
        "    total_orders,\n",
        "    total_revenue,\n",
        "    avg_order_value,\n",
        "    lifetime_value_actual\n",
        "FROM gold.revenue_by_customer\n",
        "ORDER BY total_revenue DESC, customer_id ASC\n",
        "LIMIT 500;"
      ]
    }
  ],
