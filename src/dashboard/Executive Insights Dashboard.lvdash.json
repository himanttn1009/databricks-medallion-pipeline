                  "fields": [
                    {
                      "name": "sum(total_revenue)",
                      "expression": "SUM(`total_revenue`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": { "showTitle": true, "title": "Revenue" },
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "sum(total_revenue)" } },
              "data": { "queryName": "main_query" }
            }
          },
          "position": { "x": 0, "y": 0, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "ex_high_value_count",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ex_kpi_02",
                  "fields": [
                    { "name": "sum(total_orders)", "expression": "SUM(`total_orders`)" }
