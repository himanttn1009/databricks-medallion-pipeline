              "encodings": {
                "x": { "fieldName": "sum(total_revenue)", "scale": { "type": "quantitative" } },
                "y": { "fieldName": "product_name", "scale": { "type": "categorical" } },
                "color": { "fieldName": "category", "scale": { "type": "categorical" } }
