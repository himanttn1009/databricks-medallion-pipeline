        {
          "widget": {
            "name": "ex_aov_distribution",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ex_viz_02",
                  "fields": [
                    { "name": "customer_id", "expression": "`customer_id`" },
