        {
          "widget": {
            "name": "ex_active_products",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ex_kpi_04",
                  "fields": [
                    { "name": "sum(product_count)", "expression": "SUM(`product_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": { "showTitle": true, "title": "Active Products" },
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "sum(product_count)" } },
              "data": { "queryName": "main_query" }
            }
          },
          "position": { "x": 9, "y": 0, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "ex_top_customers",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ex_viz_01",
                  "fields": [
                    { "name": "category", "expression": "`category`" },
                    { "name": "sum(total_revenue)", "expression": "SUM(`total_revenue`)" },
