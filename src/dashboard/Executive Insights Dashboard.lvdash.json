{
  "datasets": [
    {
      "name": "ex_kpi_01",
      "displayName": "EX-KPI-01 Revenue",
      "queryLines": [
        "SELECT ROUND(SUM(total_revenue), 2) AS total_revenue\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "ex_kpi_02",
      "displayName": "EX-KPI-02 High-Value Customer Count",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_orders\n",
        "FROM gold.revenue_by_customer\n",
        "WHERE total_orders >= 2\n",
        "  AND total_revenue >= (\n",
        "    SELECT percentile_approx(total_revenue, 0.75)\n",
        "    FROM gold.revenue_by_customer\n",
        "    WHERE total_orders >= 1\n",
        "  );"
      ]
    },
    {
      "name": "ex_kpi_03",
      "displayName": "EX-KPI-03 Inactive Customers",
      "queryLines": [
        "SELECT COUNT(*) AS customer_count\n",
        "FROM gold.revenue_by_customer\n",
        "WHERE total_orders = 0;"
      ]
    },
    {
      "name": "ex_kpi_04",
      "displayName": "EX-KPI-04 Active Products",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  COUNT(product_id) AS product_count\n",
        "FROM gold.sales_by_product\n",
        "GROUP BY category\n",
        "ORDER BY category;"
      ]
    },
    {
      "name": "ex_viz_01",
      "displayName": "EX-VIZ-01 Top 10 Customers by Revenue",
      "queryLines": [
        "SELECT\n",
        "  customer_name AS product_name,\n",
        "  customer_segment AS category,\n",
        "  total_revenue,\n",
        "  total_orders\n",
        "FROM gold.revenue_by_customer\n",
        "ORDER BY total_revenue DESC, customer_name ASC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "ex_viz_02",
      "displayName": "EX-VIZ-02 Avg Order Value Distribution",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  customer_segment,\n",
        "  COALESCE(avg_order_value, 0) AS total_revenue\n",
        "FROM gold.revenue_by_customer;"
      ]
    },
    {
      "name": "ex_viz_03",
      "displayName": "EX-VIZ-03 Behavioral Revenue Share",
      "queryLines": [
        "SELECT\n",
        "  segment_type,\n",
        "  customer_count,\n",
        "  total_revenue,\n",
        "  avg_revenue\n",
        "FROM gold.customer_segmentation\n",
        "ORDER BY\n",
        "  CASE segment_type\n",
        "    WHEN 'High-Value' THEN 1\n",
        "    WHEN 'Repeat' THEN 2\n",
        "    WHEN 'One-Time' THEN 3\n",
        "    WHEN 'Inactive' THEN 4\n",
        "    ELSE 5\n",
        "  END;"
      ]
    },
    {
      "name": "ex_viz_04",
      "displayName": "EX-VIZ-04 Revenue Trend",
      "queryLines": [
        "SELECT\n",
        "  period_start,\n",
        "  period_type,\n",
        "  total_revenue,\n",
        "  total_orders\n",
        "FROM gold.daily_weekly_trends\n",
        "ORDER BY period_start ASC;"
      ]
    },
    {
      "name": "ex_tbl_01",
      "displayName": "EX-TBL-01 Customer Priority Table",
      "queryLines": [
        "SELECT\n",
        "  customer_id,\n",
        "  customer_name,\n",
        "  customer_segment,\n",
        "  total_orders,\n",
        "  total_revenue,\n",
        "  avg_order_value,\n",
        "  lifetime_value_actual\n",
        "FROM gold.revenue_by_customer\n",
        "ORDER BY total_revenue DESC, customer_id ASC\n",
        "LIMIT 500;"
      ]
    }
  ],
  "pages": [
    {
      "name": "ex_dashboard_page",
      "displayName": "Executive Insights Dashboard",
      "layout": [
        {
          "widget": {
