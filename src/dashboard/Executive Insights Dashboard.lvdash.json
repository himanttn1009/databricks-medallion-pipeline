          "position": { "x": 3, "y": 0, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "ex_inactive_count",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ex_kpi_03",
                  "fields": [
                    { "name": "sum(customer_count)", "expression": "SUM(`customer_count`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": { "showTitle": true, "title": "Inactive Customers" },
              "widgetType": "counter",
              "encodings": { "value": { "fieldName": "sum(customer_count)" } },
              "data": { "queryName": "main_query" }
